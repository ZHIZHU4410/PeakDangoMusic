<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework><LangVersion>latest</LangVersion><AssemblyName>PeakDangoMusic</AssemblyName><Version>1.1.2</Version>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable><DebugType>embedded</DebugType><NoWarn>$(NoWarn);CS0618</NoWarn>
    <GameRoot Condition="'$(GameRoot)'==''">$(MSBuildProjectDirectory)\..\..\..</GameRoot>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="$(GameRoot)\BepInEx\core\BepInEx.dll" Private="false" />
    <Reference Include="$(GameRoot)\BepInEx\core\0Harmony.dll" Private="false" />
    <Reference Include="$(GameRoot)\PEAK_Data\Managed\*.dll" Private="false" Exclude="$(GameRoot)\PEAK_Data\Managed\System*.dll;$(GameRoot)\PEAK_Data\Managed\Mono*.dll;$(GameRoot)\PEAK_Data\Managed\mscorlib.dll;$(GameRoot)\PEAK_Data\Managed\netstandard.dll" />
  </ItemGroup>
</Project>
